    {"name": "北极", "PaintA": "#d0d4d6", "PaintB": "#7b8288", "Accent": "#c23a2e"},
    {"name": "海军蓝", "PaintA": "#2f4058", "PaintB": "#1c2634", "Accent": "#c23a2e"},
    {"name": "警戒橙", "PaintA": "#d0782f", "PaintB": "#2b2f33", "Accent": "#c23a2e"},
    {"name": "丛林", "PaintA": "#4f6b3a", "PaintB": "#2c3a22", "Accent": "#c23a2e"},
    {"name": "黑色行动", "PaintA": "#1f2226", "PaintB": "#3b3f44", "Accent": "#c23a2e"}
  ]
